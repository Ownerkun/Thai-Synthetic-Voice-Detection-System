# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของตัวเอง
# .env ต้องไม่ commit เข้า git (อยู่ใน .gitignore แล้ว)

# --- Postgres (ใช้โดย db service ใน docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spoof_detection
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/spoof_detection
# สร้างค่าใหม่ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
CORS_ORIGINS=*

# บัญชีแอดมินคนแรกที่ระบบจะสร้างให้อัตโนมัติตอน startup ถ้ายังไม่มีแอดมินในระบบเลย
# ตั้งรหัสผ่านที่นี่ครั้งแรก แล้วค่อยลบ/เว้นว่างทิ้งไว้หลังสร้างบัญชีจริงแล้วเพื่อความปลอดภัย
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- pgAdmin (optional, เปิดด้วย: docker compose --profile tools up -d) ---
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=devpassword
PGADMIN_PORT=5050

# --- อีเมล (ยืนยันอีเมลตอนสมัคร + ลืมรหัสผ่าน) ดูรายละเอียดที่ docs/EMAIL_SETUP.md ---
# console = ไม่ส่งจริง พิมพ์ลง log (dev) · smtp = ส่งจริง
MAIL_BACKEND=console
# ลิงก์ในอีเมลชี้ไปหน้าเว็บ (ตอน deploy ใส่ https://ชื่อของคุณ.duckdns.org ไม่ต้องมี / ท้าย)
FRONTEND_BASE_URL=http://localhost:3000

# ใช้เมื่อ MAIL_BACKEND=smtp (ตัวอย่างนี้คือ Gmail + App Password)
# MAIL_FROM_ADDRESS ต้องเป็นที่อยู่ Gmail เดียวกับ SMTP_USERNAME
MAIL_FROM_ADDRESS=your.account@gmail.com
MAIL_FROM_NAME=Thai Synthetic Voice Detection
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your.account@gmail.com
SMTP_PASSWORD=CHANGE_ME_TO_A_16_CHAR_APP_PASSWORD

# --- แปลงไฟล์เสียง (ไม่บังคับ) ---
# FFMPEG_PATH=ffmpeg              # ชื่อคำสั่ง หรือ path เต็มถ้า ffmpeg ไม่อยู่ใน PATH
# FFMPEG_TIMEOUT_SECONDS=30       # แปลงนานเกินนี้ถือว่าไฟล์เสียหาย
