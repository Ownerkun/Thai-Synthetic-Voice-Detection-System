# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของตัวเอง
# .env ต้องไม่ commit เข้า git (อยู่ใน .gitignore แล้ว)

# --- Postgres (ใช้โดย db service ใน docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spoof_detection
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/spoof_detection
# สร้างค่าใหม่ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
CORS_ORIGINS=*

# บัญชีแอดมินคนแรกที่ระบบจะสร้างให้อัตโนมัติตอน startup ถ้ายังไม่มีแอดมินในระบบเลย
# ตั้งรหัสผ่านที่นี่ครั้งแรก แล้วค่อยลบ/เว้นว่างทิ้งไว้หลังสร้างบัญชีจริงแล้วเพื่อความปลอดภัย
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- pgAdmin (optional, เปิดด้วย: docker compose --profile tools up -d) ---
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=devpassword
PGADMIN_PORT=5050
