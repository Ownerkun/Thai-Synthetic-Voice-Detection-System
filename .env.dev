# Dev environment committed to git
# Values here are for LOCAL DEVELOPMENT ONLY not for production
#
# --- วิธีใช้กับ Docker (แนะนำ) ---
#   docker compose up --build
#
# --- วิธีใช้รัน local โดยไม่มี Docker ---
#   cp .env.dev .env   (แล้วแก้ DATABASE_URL ให้ชี้ไป localhost แทน db)
#
# --- ถ้ามี volume เดิมอยู่แล้ว ---
#   ถ้า db เคย init ด้วย POSTGRES_PASSWORD ค่าอื่น (เช่นจาก .env เดิม)
#   จำเป็นต้องลบ volume แล้ว recreate: docker compose down -v && docker compose up --build

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spoof_detection
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/spoof_detection

# Dev JWT secret ใช้ได้แค่ตอน dev เท่านั้น
# สำหรับ production ให้สร้างค่าใหม่ด้วย
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-thai-spoof_detection-system-naja

CORS_ORIGINS=*

# --- Admin bootstrap ---
# บัญชีแอดมินคนแรก สร้างอัตโนมัติตอน startup ถ้ายังไม่มีแอดมินในระบบ
# เปลี่ยนรหัสผ่านหลัง login ครั้งแรก หรือว่างทิ้งไว้เพื่อปิดการสร้างอัตโนมัติ
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin6767naja

# --- pgAdmin (optional) ---
# เปิดด้วย: docker compose --profile tools up -d
# เข้าที่: http://localhost:5050
PGADMIN_EMAIL=thaispoof@mail.com
PGADMIN_PASSWORD=thaispoof1234
PGADMIN_PORT=5050
